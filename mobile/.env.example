# Same Supabase project as the web app (see root .env: VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY).
# Without these the app runs in demo mode with sample data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Places/Maps API key. Utility only: address autocomplete on new
# jobs, Street View previews, and the public-view profile audit. Listing
# management goes through the Business Profile API below.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Business Profile (owner-authorized) — powers every GMB feature:
# profile info, hours, posts, and review replies. Normally the owner signs
# in with Google on the web dashboard and the token lands in the
# google_oauth_tokens table; these two are a shortcut for local testing.
# Requires Business Profile API access approval from Google.
EXPO_PUBLIC_GMB_ACCESS_TOKEN=
# accounts/{accountId}/locations/{locationId}
EXPO_PUBLIC_GMB_LOCATION=

# Deployed web app URL (knowledge-base links, review funnel links).
EXPO_PUBLIC_APP_URL=

# Deployed Express API base URL (secret-bearing operations and the
# Complete & Publish workflow webhook).
EXPO_PUBLIC_API_BASE_URL=

# Automation workflow id that receives job.completed publishes
# (create the workflow in the web app's Workflow Builder, then paste its id).
EXPO_PUBLIC_PUBLISH_WEBHOOK_ID=
