# Same Supabase project as the web app (see root .env: VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY).
# Without these the app runs in demo mode with sample data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Deployed Express API base URL (secret-bearing operations: AI review replies,
# Twilio SMS, payments, Google place lookup). Not used by the foundation yet.
EXPO_PUBLIC_API_BASE_URL=
