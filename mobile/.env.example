# Same Supabase project as the web app (see root .env: VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY).
# Without these the app runs in demo mode with sample data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps API key: address autocomplete, Street View, GMB connect/scan.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Deployed web app URL (knowledge-base links, review funnel links).
EXPO_PUBLIC_APP_URL=

# Deployed Express API base URL (secret-bearing operations and the
# Complete & Publish workflow webhook).
EXPO_PUBLIC_API_BASE_URL=

# Automation workflow id that receives job.completed publishes
# (create the workflow in the web app's Workflow Builder, then paste its id).
EXPO_PUBLIC_PUBLISH_WEBHOOK_ID=
