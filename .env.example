# Local SEO Ranker - environment variables
# Copy to .env (local dev) and fill in values. Never commit .env.
# [secret] = keep out of logs, client bundles and version control.

# ---------------------------------------------------------------------------
# Client (VITE_* are inlined into the browser bundle at build time - public)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co   # Supabase project URL
VITE_SUPABASE_ANON_KEY=                              # Supabase anon (public) key
VITE_GOOGLE_MAPS_API_KEY=                            # Browser-restricted Maps JS key
VITE_VAPID_PUBLIC_KEY=                               # Web Push public key (optional)
VITE_SENTRY_DSN=                                     # Sentry browser DSN (optional)
VITE_API_URL=/api                                    # API base path (default /api)
VITE_GOOGLE_AUTH_ENABLED=false                       # "true" once Google OAuth is configured in Supabase

# ---------------------------------------------------------------------------
# Server (Express API - never exposed to the browser)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co        # Same project as above
SUPABASE_SERVICE_ROLE_KEY=                           # [secret] Supabase service role key
APP_URL=http://localhost:5173                        # Strongly recommended. Required for Google OAuth redirects and outbound webhooks
CORS_ORIGINS=http://localhost:5173                   # Comma-separated allowlist (defaults to APP_URL)
SENTRY_DSN=                                          # Sentry server DSN (optional)
SENTRY_ENVIRONMENT=production                        # Sentry environment tag (defaults to NODE_ENV)
SENTRY_TRACES_SAMPLE_RATE=0                          # 0-1; tracing is off unless set
LOG_LEVEL=info                                       # pino log level
PORT=8080                                            # API listen port
DISABLE_WORKER=                                      # "true" kills the in-process automation worker (server/lib/worker.ts)

GOOGLE_MAPS_API_KEY=                                 # [secret] Server-side Maps/Places key
GOOGLE_OAUTH_CLIENT_ID=                              # Google Business Profile OAuth
GOOGLE_OAUTH_CLIENT_SECRET=                          # [secret]

OPENAI_API_KEY=                                      # [secret] AI content features
OPENAI_MODEL=gpt-4o-mini                             # Model used for generation
OPENAI_VISION_MODEL=gpt-4o-mini                      # Model used for image alt-text (server/routes/ai.ts)

DATAFORSEO_USERNAME=                                 # DataForSEO API login
DATAFORSEO_PASSWORD=                                 # [secret]
DATAFORSEO_DAILY_LIMIT=200                           # Per-user daily task quota (in-memory, per process)

STRIPE_SECRET_KEY=                                   # [secret] Stripe server key
STRIPE_WEBHOOK_SECRET=                               # [secret] Stripe webhook signing secret

# In-app purchases (RevenueCat — App Store + Google Play)
REVENUECAT_WEBHOOK_AUTH=                             # [secret] shared header value set in the RevenueCat webhook config
REVENUECAT_API_KEY=                                  # [secret] RevenueCat REST secret key (optional; server-side lookups)
# Client (public) RevenueCat SDK keys — set at build time for the mobile app:
#   EXPO_PUBLIC_REVENUECAT_IOS_KEY, EXPO_PUBLIC_REVENUECAT_ANDROID_KEY

TWILIO_ACCOUNT_SID=                                  # SMS review requests
TWILIO_AUTH_TOKEN=                                   # [secret]
TWILIO_PHONE_NUMBER=                                 # E.164 sender number
TWILIO_WEBHOOK_URL=                                  # Public URL for Twilio status callbacks

# ---------------------------------------------------------------------------
# Outbound email (server/lib/email.ts). Without these, email silently no-ops.
# ---------------------------------------------------------------------------
SMTP_HOST=                                           # SMTP server hostname
SMTP_PORT=587                                        # SMTP port
SMTP_USER=                                           # SMTP username
SMTP_PASSWORD=                                       # [secret] SMTP password
FROM_EMAIL=                                          # Envelope/from address
MAILGUN_API_KEY=                                     # [secret] Mailgun fallback
MAILGUN_DOMAIN=                                      # Mailgun sending domain
