{
  "name": "local-seo-ranker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "20.19.0",
    "npm": "10.8.2"
  },
  "scripts": {
    "dev": "vite",
    "dev:vite": "vite",
    "build": "tsc && vite build",
    "build:client": "tsc && vite build",
    "build:server": "vite build --config vite.config.server.ts",
    "build:full": "npm run build:client && npm run build:server",
    "prestart": "npm run build:server",
    "start": "node dist/server/node-build.mjs",
    "start:static": "serve dist -l ${PORT:-8080} -s",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "setup": "node scripts/setup-supabase.js",
    "populate-data": "tsx scripts/populate-sample-data.ts",
    "setup-db": "npm run populate-data",
    "server:dev": "cd server_complete && npm run dev",
    "server:build": "cd server_complete && npm run build",
    "full:dev": "concurrently \"npm run dev\" \"npm run server:dev\"",
    "typecheck": "tsc --noEmit",
    "postinstall": "echo '\n🚀 Local SEO Ranker setup complete!\nRun: npm run setup (to configure Supabase)'"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-accordion": "^1.1.2",
